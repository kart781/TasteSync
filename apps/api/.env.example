DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
PORT=3000
# Secret for HMAC of phone numbers. Generate with: openssl rand -hex 32
PHONE_HASH_SECRET=
# Path to the Firebase service account JSON, or leave empty to use GOOGLE_APPLICATION_CREDENTIALS
FIREBASE_SERVICE_ACCOUNT=
# Development only: accept "dev:<uid>:<phone>" tokens instead of Firebase tokens. Never set in production.
DEV_AUTH=true
